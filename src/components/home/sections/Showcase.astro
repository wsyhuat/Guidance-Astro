---
const module = {
    cn: '智能驾驶实验室',
    en: 'SHOWCASE LAB',
    link: '/showcase-dashboard/',
    image: '/assets/huat.jpg',
    desc: '用完全本地的数据、SVG 可视化和浏览器状态管理，直观展示无人驾驶赛车从感知到执行器的整条闭环。',
};
---

<section class="showcase-hero fs-full-bleed" role="region" aria-label="功能模块">
    <div class="showcase-slide-bg" style={`background-image: url(${module.image});`}></div>
    <div class="showcase-overlay"></div>

    <div class="showcase-content">
        <span class="showcase-en">{module.en}</span>
        <h2 class="showcase-title">{module.cn}</h2>
        <p class="showcase-desc">{module.desc}</p>
        <a class="showcase-cta fs-cta-clip" href={module.link}>
            了解更多
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
    </div>
</section>

<style>
    .showcase-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: var(--fs-bg-base);
    }

    .showcase-slide-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0.7;
    }

    .showcase-overlay {
        position: absolute;
        inset: 0;
        background: 
            linear-gradient(180deg, #ffffff 0%, rgba(255,255,255,0.8) 8%, rgba(255,255,255,0) 20%),
            rgba(0,0,0,0.55);
        pointer-events: none;
        z-index: 1;
    }

    .showcase-content {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 800px;
    }

    .showcase-en {
        display: block;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 6px;
        color: var(--fs-color-on-image) !important;
        margin-bottom: 1.5rem;
    }

    .showcase-title {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: clamp(3rem, 8vw, 5.5rem);
        font-weight: 900;
        color: var(--fs-color-on-image) !important;
        margin: 0 0 1.5rem;
        line-height: 1.1;
        text-shadow: 0 4px 20px rgba(0,0,0,0.6), 0 2px 8px rgba(0,0,0,0.4);
    }

    .showcase-desc {
        font-size: 1.25rem;
        line-height: 1.8;
        color: var(--fs-color-on-image) !important;
        margin: 0 0 2.5rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .showcase-cta svg {
        transition: transform 0.3s ease;
    }
    .showcase-cta:hover svg {
        transform: translateX(4px);
    }

    @media (max-width: 768px) {
        .showcase-content { padding: 2rem 1.5rem; }
    }
</style>
